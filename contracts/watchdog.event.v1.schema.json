{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://watchdog-hub.local/contracts/watchdog.event.v1.json",
  "title": "watchdog.event.v1",
  "description": "Fait technique immuable émis par un adaptateur vers Watchdog-Fleet. Ce n'est ni une anomalie, ni un incident, ni une donnée métier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "flow_id",
    "event_type",
    "status",
    "timestamp",
    "source_id",
    "connector_id",
    "destination_id"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "watchdog.event.v1"
    },
    "event_id": {
      "type": "string",
      "description": "Identifiant unique mondial (UUID v4 ou ULID).",
      "oneOf": [
        {
          "title": "uuid-v4",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        {
          "title": "ulid",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      ]
    },
    "flow_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Identifiant Watchdog du flux (ex. METEO_01), pas un id interne CSV/Node-RED."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "execution_started",
        "execution_completed",
        "execution_failed",
        "data_received",
        "data_missing",
        "connector_error",
        "timeout",
        "validation_failed",
        "destination_error"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial", "info"]
    },
    "timestamp": {
      "type": "string",
      "description": "Instant du fait, ISO-8601 UTC avec suffixe Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "source_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "connector_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "destination_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "integer",
      "minimum": 0,
      "description": "Volume de l'exécution. Jamais un tableau de lignes métier."
    },
    "error_signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Signature stable (sans timestamp, sans UUID de run). Obligatoire si status=failure."
    },
    "correlation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Optionnel. Si absent, Watchdog la dérive (flow_id|family|error_signature)."
    },
    "producer": {
      "type": "string",
      "enum": ["csv-to-sql", "api-meteo", "bacnet-gateway", "watchdog-internal"]
    },
    "metadata": {
      "type": "object",
      "description": "Métadonnées techniques bornées. Pas de lignes CSV, pas de mesures, pas de secrets."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["execution_started", "execution_completed", "execution_failed"]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "required": ["execution_id"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failure" } },
        "required": ["status"]
      },
      "then": {
        "required": ["error_signature"]
      }
    }
  ]
}
