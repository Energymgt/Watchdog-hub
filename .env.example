# Copier vers .env à la racine du repo, ou coller dans Portainer → Env.

USERNAME=admin
PASSWORD=
ENCRYPTION_KEY=
# Phase DEV : tag mutable, Portainer n'a pas besoin de changer cette valeur.
WATCHDOG_HUB_IMAGE=kxchrisemgt/watchdog-hub:DEV
# Release : kxchrisemgt/watchdog-hub:1.2.3 (tag immuable)

# URL Workflow Teams (logic.azure.com) — ne pas committer
TEAMS_WEBHOOK_URL=

# Balena Cloud — token device:read, ID numérique /apps/NNNNN
BALENA_API_TOKEN=
BALENA_APP_ID=
FLEET_HEARTBEAT_TTL_DAYS=30
FORCE_COPY_FLOWS=false

# Ingest HTTP (Lots 1-5) dans le même conteneur siège, port hôte 8091
WATCHDOG_INGEST_BIND=0.0.0.0
WATCHDOG_INGEST_PORT=8091
WATCHDOG_REGISTRY_PATH=/data/watchdog-registry.sqlite
# Secret partagé /v1/* (header X-Watchdog-Token ou Authorization: Bearer).
# Vide = pas d'auth (dev local / tests). Production : OBLIGATOIRE avant de publier 8091.
# Ne jamais committer une valeur réelle.
WATCHDOG_INGEST_TOKEN=
