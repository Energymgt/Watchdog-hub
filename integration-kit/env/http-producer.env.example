# L'émission doit rester désactivée jusqu'à la recette.
WATCHDOG_ENABLED=false
WATCHDOG_URL=http://watchdog-host:8091/v1/events

# Même secret que WATCHDOG_INGEST_TOKEN côté Watchdog Hub.
# Ne jamais committer une valeur réelle.
WATCHDOG_TOKEN=

# Timeout court pour ne jamais bloquer le traitement métier.
WATCHDOG_TIMEOUT_MS=3000
