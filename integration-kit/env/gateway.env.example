# Identité injectée par Balena en production
BALENA_DEVICE_UUID=
BALENA_DEVICE_NAME_AT_INIT=
BALENA_APP_NAME=

# Broker Watchdog - credentials à fournir par le secret store du déploiement
WATCHDOG_MQTT_HOST=iot.energymgt.io
WATCHDOG_MQTT_PORT=1883
WATCHDOG_MQTT_USERNAME=
WATCHDOG_MQTT_PASSWORD=

# Contrôles locaux
WATCHDOG_BOOT_GRACE_S=180
WATCHDOG_MODBUS_STALE_S=120

# Optionnel - ne jamais committer une URL réelle
TEAMS_WEBHOOK_URL=
